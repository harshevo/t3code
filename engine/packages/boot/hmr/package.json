{
  "name": "@deepseek-ai/dsh-hmr",
  "version": "0.2.1-alpha.1",
  "private": true,
  "description": "Coordinated module and profile configuration hot reload",
  "license": "MIT",
  "author": "Shigma <shigma10826@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/hmr"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "@deepseek-ai/schemastery": "workspace:~",
    "chokidar": "^4.0.3",
    "node-addon-require-builtin": "^0.1.6",
    "picomatch": "^4.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-cmdline": "workspace:*"
  }
}
