  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-fetch-http"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "type": "module",
