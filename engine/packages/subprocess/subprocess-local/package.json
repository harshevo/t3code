{
  "name": "@deepseek-ai/dsh-subprocess-local",
  "version": "0.2.1-alpha.1",
  "private": true,
  "description": "Local-subprocess implementation of the DeepSeek Harness subprocess seam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "files": [
    "lib/index.js",
    "lib/runner.js",
    "lib/runner-*.js",
    "lib/output.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./output": {
      "types": "./lib/types/output.d.ts",
      "default": "./lib/output.js"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-lazy-require": "workspace:*",
    "@deepseek-ai/dsh-win32-process": "workspace:*",
    "koffi": "3.1.1",
    "node-pty": "1.2.0-beta.15"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-timeout": "workspace:*"
  }
}
